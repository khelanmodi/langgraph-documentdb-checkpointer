# Environment variables for LangGraph DocumentDB Checkpointer Test
# Copy this file to .env and fill in your actual values

# OpenAI API Key for LLM calls
OPENAI_API_KEY=your_openai_api_key_here

# Azure DocumentDB (CosmosDB) connection string
DOCUMENTDB_URI=mongodb+srv://your_username:your_password@your_cluster.cosmos.azure.com/?tls=true&retrywrites=false&maxIdleTimeMS=120000